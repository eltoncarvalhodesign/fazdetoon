{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/v2", "destination": "/v2/index.html" }
  ],
  "headers": [
    {
      "source": "/v2/assets/frames/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/v2/assets/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
